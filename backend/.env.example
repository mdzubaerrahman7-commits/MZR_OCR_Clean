# Copy to .env and fill in for local development / deployment.

# Point at a real PostgreSQL instance in every non-throwaway environment
# (Supabase Postgres connection string works unmodified here).
DATABASE_URL=postgresql+psycopg://bondaudit:bondaudit@localhost:5432/bondaudit

JWT_SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=480

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./evidence_storage

# Only needed when STORAGE_BACKEND=s3 (Supabase Storage speaks the S3 API too)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=

CORS_ORIGINS=["http://localhost:3000"]
